rules_version = '2';

// Matches FIRESTORE.md. Paste into Firebase console > Firestore > Rules
// only after the code using the new structure is merged.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // in a map field, only the entry under my uid changed
    function onlyMyEntry(field) {
      return request.resource.data.get(field, {})
               .diff(resource.data.get(field, {}))
               .affectedKeys().hasOnly([request.auth.uid]);
    }
    // admins/{uid} is added by hand in the Firebase console, never from the app
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // my rating is either removed or a whole number 1-5
    function validRating() {
      let mine = request.resource.data.get("ratings", {}).get(request.auth.uid, 0);
      return mine == 0 || (mine is int && mine >= 1 && mine <= 5);
    }
    // a non-empty string of at most max characters
    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }
    // the fields this update changes
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // older reports kept the author's uid in "owner"
    function ownerOf(data) {
      return data.get("ownerId", data.get("owner", ""));
    }
    // a new post or report: written by me, with a real name, a picture or null,
    // and the server's time (so the date can't be faked)
    function validAuthor() {
      let data = request.resource.data;
      return isMe(data.ownerId)
             && validText(data.ownerName, 50)
             && (data.ownerAvatar == null || data.ownerAvatar is map)
             && data.createdAt == request.time;
    }

    // admin page (admin.html): admins can read and delete anything, including old collections
    match /{document=**} {
      allow read, delete: if isAdmin();
    }

    // lets the app check if I'm an admin; no one can write here from the app
    match /admins/{uid} {
      allow read: if isMe(uid);
    }

    match /users/{uid} {
      // profile, avatar and saved maps: owner only
      allow read, write: if isMe(uid);

      // private history and post index: owner only
      match /{subcollection}/{docId} {
        allow read, write: if isMe(uid)
                           && subcollection in ["linkChecks", "postedReports", "postedHelp"];
      }
    }

    // each user's current name and avatar, so posts show them: anyone signed in reads, owner writes
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
                            && request.resource.data.keys().hasOnly(["name", "avatar"])
                            && (!("name" in request.resource.data)
                                || validText(request.resource.data.name, 50));
    }

    // scam reports: the author can edit the text or delete; anyone else can add or remove
    // their own "I've seen this" (not the author, and no one can fake the count)
    match /scamReports/{reportId} {
      allow read: if signedIn();
      allow create: if validAuthor()
                    && request.resource.data.keys().hasOnly(
                         ["query", "details", "ownerId", "ownerName", "ownerAvatar", "createdAt"])
                    && validText(request.resource.data.query, 120)
                    && validText(request.resource.data.details, 5000);
      allow update: if isMe(ownerOf(resource.data))
                    && changedKeys().hasOnly(["query", "details"])
                    && validText(request.resource.data.query, 120)
                    && validText(request.resource.data.details, 5000);
      allow delete: if isMe(ownerOf(resource.data));
      allow update: if signedIn()
                    && !isMe(ownerOf(resource.data))
                    && changedKeys().hasOnly(["seenBy"])
                    && onlyMyEntry("seenBy")
                    && request.resource.data.get("seenBy", {}).get(request.auth.uid, true) == true;
      // admins can remove anyone's "I've seen this" (when deleting a user)
      allow update: if isAdmin() && changedKeys().hasOnly(["seenBy"]);
    }

    // help posts: author deletes; anyone can rate/comment inside their own uid entry.
    // New posts start with no ratings or comments, so no one can give themselves stars.
    match /helpPosts/{postId} {
      allow read: if signedIn();
      allow create: if validAuthor()
                    && request.resource.data.keys().hasOnly(
                         ["question", "ownerId", "ownerName", "ownerAvatar", "createdAt"])
                    && validText(request.resource.data.question, 1000);
      allow delete: if isMe(resource.data.ownerId);
      // admins can remove anyone's comments or ratings
      allow update: if isAdmin()
                    && changedKeys().hasOnly(["ratings", "comments"]);
      allow update: if signedIn()
                    && changedKeys().hasOnly(["ratings", "comments"])
                    && onlyMyEntry("ratings")
                    && onlyMyEntry("comments")
                    && validRating();
    }
  }
}
